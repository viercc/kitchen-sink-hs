cabal-version:       3.0
name:                lattices
version:             0.1.0.0
synopsis:            Various order structures
build-type:          Simple

library
  hs-source-dirs:      src
  exposed-modules:     Lattice,
                       Lattice.BitSet,
                       Lattice.Classes,
                       Lattice.Dual,
                       Lattice.Ordered,
                       FinCoFin,
                       POrd
  build-depends:       base >= 4.7 && < 5,
                       containers, deepseq
  default-language:    Haskell2010
  ghc-options:         -Wall -Wno-dodgy-exports

